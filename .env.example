# Postgres
POSTGRES_USER=smartdoc
POSTGRES_PASSWORD=smartdoc
POSTGRES_DB=smartdoc

# Used by docker-compose to build the local frontend image against the local API.
# Do not set this on Vercel. The public demo analyzes files in the browser.
VITE_API_URL=http://localhost:8000/api/v1

# See backend/.env.example and frontend/.env.example for service-specific variables.
# Copy this file to .env, and copy backend/.env.example to backend/.env before running docker compose.
