# Postgres
POSTGRES_USER=smartdoc
POSTGRES_PASSWORD=smartdoc
POSTGRES_DB=smartdoc

# Used by docker-compose to build the local frontend image against the local API.
# Do not set this on Vercel. The public demo analyzes files in the browser.
VITE_API_URL=http://localhost:8000/api/v1

# Optional. Without this file, docker compose uses a dev-only JWT secret.
# Set your own for anything beyond your machine (`openssl rand -hex 32`).
# JWT_SECRET=

# Copying this file to .env and backend/.env.example to backend/.env is optional.
# docker compose up --build works from a fresh clone with the defaults above.
