DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql://smartdoc:smartdoc@db:5432/smartdoc
REDIS_URL=redis://redis:6379/0

# Required for the API without Docker. At least 16 characters. Generate one with
# `openssl rand -hex 32`. The placeholder below is rejected on purpose.
# Docker Compose ignores this value and uses JWT_SECRET from the root .env, or a
# dev-only default when that is unset.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

SPACY_MODEL=en_core_web_sm
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
CACHE_TTL_SECONDS=86400

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
